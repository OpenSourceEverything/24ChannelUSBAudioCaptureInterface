#!/usr/bin/env python3
"""Human entry point for board access and the pinned Yocto development image."""
import argparse
import glob
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import urllib.request

ROOT = Path(__file__).resolve().parent
LOCAL = ROOT / '.local'
LOCK = ROOT / 'firmware' / 'sources.json'


def run(args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def serial_port(explicit=None):
    if explicit:
        return explicit
    candidates = sorted(glob.glob('/dev/serial/by-id/*FTDI*'))
    if not candidates:
        candidates = sorted(glob.glob('/dev/ttyUSB*'))
    if len(candidates) != 1:
        raise RuntimeError('Plug in the UART adapter, or select it with --port PATH. '
                           f'Found {len(candidates)} possible adapters.')
    return candidates[0]


def digest(path):
    with Path(path).open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def process_identity(pid):
    """Identify a live Linux process without confusing a reused PID or reboot."""
    try:
        pid = int(pid)
        if pid <= 0:
            return None
        fields = (Path('/proc') / str(pid) / 'stat').read_text().rsplit(')', 1)[1].split()
        return {'pid': pid, 'start_ticks': fields[19],
                'boot_id': Path('/proc/sys/kernel/random/boot_id').read_text().strip()}
    except (OSError, ValueError, TypeError, IndexError):
        return None


def installation_status():
    path = LOCAL / 'install-status.json'
    if not path.exists():
        return None
    state = json.loads(path.read_text())
    if state['stage'] in ('BUILDING', 'CHECKING', 'WRITING'):
        recorded = state.get('process')
        if not recorded or process_identity(recorded.get('pid')) != recorded:
            state = {**state, 'stage': 'STOPPED',
                     'message': 'The installation process stopped. The SD card is not ready.',
                     'next_action': 'Leave the card in the reader; the installation job needs restarting.'}
    return state


def install_cli():
    command = Path.home() / '.local/bin/bbb'
    command.parent.mkdir(parents=True, exist_ok=True)
    if command.exists() or command.is_symlink():
        if command.resolve() != ROOT / 'device':
            raise RuntimeError(f'An unrelated command already exists at {command}; it was preserved.')
    else:
        command.symlink_to(ROOT / 'device')
    print('Ready. Type bbb to open the board terminal.')
    return command


def fetch_image():
    image = json.loads(LOCK.read_text())['bootstrap_image']
    destination = LOCAL / 'images' / image['filename']
    destination.parent.mkdir(parents=True, exist_ok=True)
    if destination.exists():
        if digest(destination) != image['sha256']:
            raise RuntimeError(f'Existing image has the wrong checksum: {destination}')
    else:
        temporary = destination.with_suffix('.download')
        print('Downloading the official Yocto board image...', flush=True)
        with urllib.request.urlopen(image.get('download_url', image['url']), timeout=60) as source:
            with temporary.open('wb') as target:
                shutil.copyfileobj(source, target, 1024 * 1024)
        if digest(temporary) != image['sha256']:
            raise RuntimeError(f'Checksum failed. Do not flash {temporary}')
        temporary.replace(destination)
    print('SHA-256 verified.', flush=True)
    print(destination)
    return destination


def setup(public_key=None):
    source = json.loads(LOCK.read_text())['poky']
    checkout = LOCAL / 'poky'
    LOCAL.mkdir(exist_ok=True)
    if not checkout.exists():
        run(['git', 'clone', '--depth', '1', '--branch', source['tag'],
             source['url'], str(checkout)])
    head = subprocess.check_output(['git', '-C', str(checkout), 'rev-parse', 'HEAD'],
                                   text=True).strip()
    if head != source['commit']:
        raise RuntimeError(f'Poky checkout differs from the pinned commit: {head}')
    changes = subprocess.check_output(['git', '-C', str(checkout), 'status',
                                      '--porcelain'], text=True)
    if changes:
        raise RuntimeError('Poky has local changes. Keep product changes in meta-ose-audio.')
    provision = LOCAL / 'provisioning'
    provision.mkdir(exist_ok=True)
    key = Path(public_key).expanduser() if public_key else Path.home() / '.ssh/id_ed25519.pub'
    if not key.exists():
        private_key = LOCAL / 'ssh/id_ed25519'
        private_key.parent.mkdir(exist_ok=True, mode=0o700)
        if not private_key.exists():
            run(['ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-f', str(private_key)])
        key = private_key.with_suffix('.pub')
    content = key.read_text().strip()
    if len(content.splitlines()) != 1 or not content.startswith(('ssh-ed25519 ', 'ssh-rsa ', 'ecdsa-sha2-')):
        raise RuntimeError('Provide one OpenSSH public key, not a private key.')
    (provision / 'authorized_keys').write_text(content + '\n')
    build = LOCAL / 'build'
    conf = build / 'conf'
    conf.mkdir(parents=True, exist_ok=True)
    layers = [checkout / 'meta', checkout / 'meta-poky', checkout / 'meta-yocto-bsp',
              ROOT / 'firmware/meta-ose-audio']
    (conf / 'bblayers.conf').write_text('POKY_BBLAYERS_CONF_VERSION = "2"\n'
        'BBPATH = "${TOPDIR}"\nBBFILES ?= ""\nBBLAYERS = "' +
        ' '.join(str(p) for p in layers) + '"\n')
    (conf / 'local.conf').write_text(
        'MACHINE = "beaglebone-yocto"\nDISTRO = "poky"\n'
        'PACKAGE_CLASSES = "package_ipk"\nINIT_MANAGER = "systemd"\n'
        'EXTRA_IMAGE_FEATURES = "empty-root-password"\n'
        'BB_NUMBER_THREADS = "2"\nPARALLEL_MAKE = "-j 2"\n'
        'PRSERV_HOST = "localhost:0"\n'
        f'DL_DIR = "{LOCAL / "downloads"}"\n'
        f'SSTATE_DIR = "{LOCAL / "sstate-cache"}"\n'
        f'AUDIO_PROVISION_DIR = "{provision}"\n'
        'CONF_VERSION = "2"\n')
    print('Yocto source pinned. Build configuration and SSH public key are ready.')
    print('Next: ./device build')


def yocto_command(target):
    checkout = LOCAL / 'poky'
    build = LOCAL / 'build'
    if not (build / 'conf/local.conf').exists():
        raise RuntimeError('Run ./device setup first.')
    environment = os.environ.copy()
    environment['LANG'] = 'en_US.UTF-8'
    environment['LC_ALL'] = 'en_US.UTF-8'
    environment['PATH'] = str(LOCAL / 'host-tools/usr/bin') + os.pathsep + environment['PATH']
    run(['bash', '-c', 'source "$1/oe-init-build-env" "$2" >/dev/null; shift 2; exec "$@"',
         'yocto-build', str(checkout), str(build), *target], env=environment)


def build_image(sdk=False, parse=False):
    source_commit = subprocess.check_output(
        ['git', '-C', str(ROOT), 'rev-parse', 'HEAD'], text=True).strip()
    source_dirty = bool(subprocess.check_output(
        ['git', '-C', str(ROOT), 'status', '--porcelain'], text=True).strip())
    target = ['bitbake', '-p'] if parse else ['bitbake', 'ose-audio-image']
    if sdk:
        target += ['-c', 'populate_sdk']
    yocto_command(target)
    if not sdk and not parse:
        output = LOCAL / 'build/tmp/deploy/images/beaglebone-yocto'
        candidates = {p.resolve() for p in output.glob('ose-audio-image-beaglebone-yocto*.wic')}
        if not candidates:
            raise RuntimeError('The build finished without an uncompressed development WIC image.')
        image = max(candidates, key=lambda p: p.stat().st_mtime)
        manifest = {'path': str(image), 'sha256': digest(image),
                    'source_commit': source_commit, 'source_dirty': source_dirty}
        (LOCAL / 'image-ready.json').write_text(json.dumps(manifest, indent=2) + '\n')
        print('Development image built and checksummed:', image)


def development_image():
    manifest_path = LOCAL / 'image-ready.json'
    if not manifest_path.exists():
        raise RuntimeError('No completed development image. Run bbb build first.')
    manifest = json.loads(manifest_path.read_text())
    image = Path(manifest['path'])
    if digest(image) != manifest['sha256']:
        raise RuntimeError('Development image checksum changed. Rebuild before flashing.')
    return image


def is_sd_card(path):
    name = Path(path).name
    if not re.fullmatch(r'mmcblk\d+', name):
        return False
    try:
        return (Path('/sys/class/block') / name / 'device/type').read_text().strip() == 'SD'
    except OSError:
        return False


def removable_card(path, inventory, image_size):
    """Reject partitions, fixed disks and mounted host filesystems before any write."""
    card = next((item for item in inventory['blockdevices'] if item.get('path') == path), None)
    removable = card and (is_sd_card(path) if re.fullmatch(r'mmcblk\d+', Path(path).name)
                          else card.get('rm'))
    if not card or card.get('type') != 'disk' or not removable:
        raise RuntimeError('Select a whole removable card, for example /dev/sdb.')
    if int(card['size']) < image_size:
        raise RuntimeError('The selected card is too small for this image.')
    pending = [card]
    while pending:
        item = pending.pop()
        for mount in item.get('mountpoints') or []:
            protected = ('/home', '/boot', '/usr', '/var', '/opt', '/srv')
            if mount and (mount in ('/', '[SWAP]') or any(mount == p or mount.startswith(p + '/') for p in protected)):
                raise RuntimeError('Refusing to write a disk containing a host filesystem.')
        pending.extend(item.get('children') or [])
    return card


def flash(path, bootstrap=False):
    image = fetch_image() if bootstrap else development_image()
    path = str(Path(path).resolve())
    inventory = json.loads(subprocess.check_output(
        ['lsblk', '--json', '--bytes', '--paths', '-o',
         'NAME,PATH,TYPE,RM,SIZE,MOUNTPOINTS'], text=True))
    card = removable_card(path, inventory, image.stat().st_size)
    print(f'Writing {image.name} to {path} ({card["size"]} bytes).', flush=True)
    pending = [card]
    while pending:
        item = pending.pop()
        if any(item.get('mountpoints') or []):
            run(['udisksctl', 'unmount', '-b', item['path']])
        pending.extend(item.get('children') or [])
    writer = '''
import hashlib, os, shutil, sys
image, target, expected = sys.argv[1:]
size = os.path.getsize(image)
with open(image, 'rb') as source, open(target, 'r+b', buffering=0) as destination:
    shutil.copyfileobj(source, destination, 1024 * 1024)
    os.fsync(destination.fileno())
with open(target, 'rb', buffering=0) as check:
    digest = hashlib.sha256()
    remaining = size
    while remaining:
        chunk = check.read(min(1024 * 1024, remaining))
        if not chunk:
            raise SystemExit('Read-back ended early; do not boot this card.')
        digest.update(chunk)
        remaining -= len(chunk)
    if digest.hexdigest() != expected:
        raise SystemExit('Read-back checksum failed; do not boot this card.')
print('Card write and read-back checksum passed.')
'''
    expected = digest(image)
    run(['docker', 'run', '--rm', '--network', 'none', '--read-only',
         '--device', path, '--mount', f'type=bind,source={image},target=/image.wic,readonly',
         'python:3.14.4-slim', 'python3', '-c', writer, '/image.wic', path, expected])
    print('Remove the card from the reader and put it in the powered-off BeagleBone.')


def ssh_command(host, remote=()):
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.:-]*', host):
        raise RuntimeError('Give only the board IP address or hostname.')
    command = ['ssh', '-o', 'ConnectTimeout=10']
    private_key = LOCAL / 'ssh/id_ed25519'
    if private_key.exists():
        command += ['-i', str(private_key)]
    return [*command, 'root@' + host, *remote]


def deploy_audio_tools(host):
    source = ROOT / 'firmware/meta-ose-audio/recipes-core/ose-audio-tools/files/audioctl'
    run(['sh', '-n', str(source)])
    remote = '''set -eu
target=$(mktemp /usr/bin/.audioctl.XXXXXX)
trap 'rm -f "$target"' EXIT
cat > "$target"
sh -n "$target"
chmod 0755 "$target"
mv -f "$target" /usr/bin/audioctl
echo 'Updated audioctl. No reboot or card removal needed.'
'''
    run(ssh_command(host, [remote]), input=source.read_bytes())


def install_package(path, host):
    package = Path(path).expanduser()
    if package.suffix != '.ipk' or not package.is_file():
        raise RuntimeError('Select an IPK package built by this Yocto configuration.')
    remote = '''set -eu
update=$(mktemp -d /tmp/ose-package.XXXXXX)
trap 'rm -rf "$update"' EXIT
cat > "$update/package.ipk"
opkg install "$update/package.ipk"
'''
    with package.open('rb') as stream:
        run(ssh_command(host, [remote]), stdin=stream)


def main():
    parser = argparse.ArgumentParser(description='Talk to the board and build its Yocto image.')
    actions = parser.add_subparsers(dest='action', required=True)
    console = actions.add_parser('console', help='Open the UART terminal; exit with Ctrl+].')
    console.add_argument('--port')
    actions.add_parser('status', help='Show the connected UART and local firmware state.')
    actions.add_parser('install-cli', help='Install the bbb shortcut without replacing another command.')
    actions.add_parser('fetch-image', help='Download the optional minimal reference/rescue image.')
    writer = actions.add_parser('flash', help='Write the completed development image to an explicitly selected card.')
    writer.add_argument('card', help='Whole removable card, for example /dev/sdb.')
    writer.add_argument('--bootstrap', action='store_true', help='Use the minimal reference image for boot diagnosis instead.')
    configure = actions.add_parser('setup', help='Fetch pinned Yocto sources and configure the image.')
    configure.add_argument('--public-key')
    build = actions.add_parser('build', help='Build our bootable Yocto image.')
    build.add_argument('--parse-only', action='store_true')
    actions.add_parser('sdk', help='Build the cross-development SDK.')
    ssh = actions.add_parser('ssh', help='Log in over USB networking or Ethernet using your SSH key.')
    ssh.add_argument('host', nargs='?', default='192.168.7.2')
    deploy = actions.add_parser('deploy', help='Update the audio menu over SSH without reflashing.')
    deploy.add_argument('host', nargs='?', default='192.168.7.2')
    package = actions.add_parser('install-package', help='Install a locally built IPK over SSH.')
    package.add_argument('path')
    package.add_argument('host', nargs='?', default='192.168.7.2')
    yocto = actions.add_parser('yocto', help='Run bitbake or devtool in the pinned build environment.')
    yocto.add_argument('command', nargs=argparse.REMAINDER)
    args = parser.parse_args(sys.argv[1:] or ['console'])
    try:
        if args.action == 'console':
            port = serial_port(args.port)
            if importlib.util.find_spec('serial') is None:
                raise RuntimeError('Install pyserial, then rerun this command.')
            print('Board terminal. Press Enter to wake it. Exit with Ctrl+].', flush=True)
            run([sys.executable, '-m', 'serial.tools.miniterm', '--dtr', '0', '--rts', '0',
                 '--eol', 'CR', port, '115200'])
        elif args.action == 'status':
            try:
                print('UART:', serial_port())
            except RuntimeError as error:
                print('UART:', error)
            print('Yocto configured:', (LOCAL / 'build/conf/local.conf').exists())
            print('Build output:', LOCAL / 'build/tmp/deploy/images/beaglebone-yocto')
            state = installation_status()
            if state:
                print('Card installation:', state['stage'])
                print(state['message'])
                if state.get('next_action'):
                    print('Next:', state['next_action'])
        elif args.action == 'install-cli':
            install_cli()
        elif args.action == 'fetch-image':
            fetch_image()
        elif args.action == 'flash':
            flash(args.card, bootstrap=args.bootstrap)
        elif args.action == 'setup':
            setup(args.public_key)
        elif args.action == 'build':
            build_image(parse=args.parse_only)
        elif args.action == 'sdk':
            build_image(sdk=True)
        elif args.action == 'ssh':
            run(ssh_command(args.host))
        elif args.action == 'deploy':
            deploy_audio_tools(args.host)
        elif args.action == 'install-package':
            install_package(args.path, args.host)
        elif args.action == 'yocto':
            if not args.command or args.command[0] not in ('bitbake', 'devtool'):
                raise RuntimeError('Use bbb yocto bitbake ... or bbb yocto devtool ...')
            yocto_command(args.command)
    except (RuntimeError, OSError, subprocess.CalledProcessError) as error:
        print(f'Error: {error}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
