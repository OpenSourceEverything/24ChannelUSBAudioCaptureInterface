[Unit]
Description=Audio bench USB networking and capture device
After=systemd-modules-load.service sys-kernel-config.mount
Requires=sys-kernel-config.mount
Wants=systemd-networkd.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=oneshot
ExecStart=/usr/bin/audioctl usb-on
ExecStop=/usr/bin/audioctl usb-off
RemainAfterExit=yes
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
